# Local Postgres, or a hosted URL. Supabase transaction pooler: port 6543, SSL required.
DATABASE_URL=postgres://eld:eld@127.0.0.1:5432/eld

# When set, the site asks for this password. Leave unset for local dev (no gate).
ACCESS_PASSWORD=

# mock (default) | live
AI_MODE=mock

# Gateway key for live mode off Vercel. On Vercel, leave empty: OIDC authenticates AI Gateway.
AI_GATEWAY_API_KEY=
