# Local Postgres. The app also runs against `supabase start` — paste that DB URL here.
DATABASE_URL=postgres://eld:eld@127.0.0.1:5432/eld

# mock (default when unset or when AI_GATEWAY_API_KEY is empty) | live
AI_MODE=mock

# One key for every model. Leave empty to stay on the deterministic mock provider.
AI_GATEWAY_API_KEY=
